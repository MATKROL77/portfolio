{
  "name": "matias-colimodio-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio de Matias Colimodio - Engineering, Design & Fabrication",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "assets": "python scripts/build_assets.py",
    "cv:pdf": "powershell -ExecutionPolicy Bypass -File scripts/cv-pdf.ps1",
    "deploy": "next build && wrangler deploy",
    "deploy:legacy": "npx wrangler deploy -c legacy-redirect/wrangler.jsonc",
    "set-access": "node scripts/set-access.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}
